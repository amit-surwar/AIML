# =========================================================================
# Pick ONE provider and set its key. Default is Groq (free, fastest).
# Free key sources:
#   Groq      -> https://console.groq.com/keys           (free, ~14.4k req/day)
#   Google    -> https://aistudio.google.com/apikey      (free, generous)
#   OpenAI    -> https://platform.openai.com/api-keys    (paid, ~$5 prepaid)
#   Anthropic -> https://console.anthropic.com/          (paid, ~$5 prepaid)
# =========================================================================

LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

LOG_LEVEL=debug

# -------------------------------------------------------------------------
# Suggested LLM_MODEL values per provider:
#   groq      -> llama-3.3-70b-versatile  |  llama-3.1-8b-instant
#   google    -> gemini-2.0-flash         |  gemini-1.5-flash
#   openai    -> gpt-4o-mini              |  gpt-4o
#   anthropic -> claude-3-5-haiku-latest  |  claude-3-5-sonnet-latest
# -------------------------------------------------------------------------
