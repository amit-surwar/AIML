{
  "name": "ai-engineering-sprint",
  "version": "0.1.0",
  "description": "14-day AI Engineering sprint — built in TypeScript, leveraging Node.js + DevOps experience.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
